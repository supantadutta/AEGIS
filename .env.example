# ============================================================================
# AEGIS — Multi-AI Blue Team Orchestrator — example environment
# Copy to .env and fill in only what you need. EVERYTHING runs with NO keys
# (deterministic MockProvider). Real providers are used only when keys exist.
# ============================================================================

# --- Provider API keys (all optional; absence => MockProvider fallback) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Orchestrator behavior ---
ROUTER_MODE=rules                 # rules | llm
ORCH_ENABLE_PARALLEL=false        # parallel only for independent steps
ALLOW_EXTERNAL_FOR_SENSITIVE=false

# --- Storage ---
AEGIS_DB_PATH=aegis.sqlite

# --- Threat intel integrations (all DISABLED by default) -------------------
# Local allow/blocklist CSVs are ALWAYS on. External sources stay disabled
# (verdict="unknown", "disabled: no API key configured") until a key is set.
MISP_URL=
MISP_API_KEY=
OPENCTI_URL=
OPENCTI_API_KEY=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=
GREYNOISE_API_KEY=
URLSCAN_API_KEY=
OTX_API_KEY=
THREATFOX_API_KEY=
MALWAREBAZAAR_API_KEY=
